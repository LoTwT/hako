{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    // 测试（tests/**）会导入 src/worker 的模块，这些模块使用标准现代 API
    // （String.replaceAll、Error cause 等）；ES2022 只影响类型检查，构建输出仍由 Vite 决定。
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "src/worker",
    // 本地开发登录共享常量属于 Node 侧项目（tsconfig.node.json）：同一文件不能
    // 同时由两个项目编译（引用项目要求已构建的声明文件）。浏览器侧只读取
    // vite.config.ts 注入的构建标志，Worker 侧从 HAKO_LOCAL_DEVELOPMENT 绑定读值，
    // 都不直接导入本文件。
    "src/shared/local-development.ts",
    "tests/integration/worker-entry.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
